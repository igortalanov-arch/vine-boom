## 10. Структура кода (псевдокод)

```javascript
// ===== ИНИЦИАЛИЗАЦИЯ =====
const scene = new THREE.Scene();
const camera = new THREE.PerspectiveCamera(60, aspect, 0.1, 1000);
const renderer = new THREE.WebGLRenderer({ canvas, antialias: true });
const controls = new OrbitControls(camera, renderer.domElement);

// ===== ГРОЗДЬ =====
const grapeGroup = new THREE.Group();
scene.add(grapeGroup);

function createBerry(layer, index) {
  const geo = new THREE.SphereGeometry(0.5, 16, 12);
  const mat = new THREE.MeshStandardMaterial({ color: 0x8bc34a });
  const mesh = new THREE.Mesh(geo, mat);
  mesh.userData.berry = { layer, ripeness: 0, feature: 'drops', ... };
  return mesh;
}

function generateGrape() {
  // Создаём 21 ягоду, распределяем по слоям
  // Позиционируем в форме конуса
}

// ===== УПРАВЛЕНИЕ =====
const interaction = new InteractionManager(camera, renderer, scene);
interaction.onCut = (berry, direction) => handleCut(berry, direction);

// ===== ЛОГИКА =====
let selectedBerries = [];

function handleCut(berry, direction) {
  if (berry.ripeness !== 2) return; // не спелая
  if (berry.isClosed) return; // закрыта
  if (berry.layer !== currentLayer) return; // не текущий слой
  
  // Анимация
  animateCut(berry, direction);
  playSound('pop');
  
  // Логика тройки
  if (selectedBerries.length === 0) {
    selectedBerries.push(berry);
  } else if (selectedBerries.length === 1) {
    if (selectedBerries[0].feature === berry.feature) {
      selectedBerries.push(berry);
    } else {
      handleError(berry);
      return;
    }
  } else if (selectedBerries.length === 2) {
    if (selectedBerries[0].feature === berry.feature) {
      selectedBerries.push(berry);
      handleSuccess(selectedBerries);
      selectedBerries = [];
    } else {
      handleError(berry);
      return;
    }
  }
}

function handleSuccess(berries) {
  // Удаляем 3 ягоды
  berries.forEach(b => removeBerry(b));
  
  // Пересчёт троек
  recalculateTriples();
  
  // Повышение спелости
  promoteRandomBerries(4);
  
  // Проверка на отсутствие спелых
  if (noRipeBerries()) {
    promoteRawestBerries(4);
  }
  
  // Проверка слоя
  if (layerCleared()) {
    nextLayer();
  }
}

function recalculateTriples() {
  const currentBerries = berries.filter(b => b.layer === currentLayer && b.isVisible);
  const count = currentBerries.length;
  const triples = Math.floor(count / 3);
  const remainder = count % 3;
  
  if (remainder > 0) {
    // Сбрасываем самые спелые
    const toRemove = currentBerries
      .sort((a, b) => b.ripeness - a.ripeness)
      .slice(0, remainder);
    toRemove.forEach(b => removeBerry(b, 'dissolve'));
    playSound('vzhuh');
  }
}

// ===== ЦИКЛ =====
function animate() {
  requestAnimationFrame(animate);
  controls.update();
  updateParticles();
  renderer.render(scene, camera);
}
```


## 11. Что проверяет макет

| Проверяемый аспект | Как проверяем | Критерий успеха |
|---|---|---|
| **Вращение грозди** | Мышь влево-вправо | Гроздь вращается, ягоды не разлетаются |
